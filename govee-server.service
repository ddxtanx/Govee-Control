# /etc/systemd/system/govee-server.service
#
# Install on your always-on machine:
#   sudo cp govee-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now govee-server
#
# Put the actual server + config in /opt/govee/ (owned by user govee).
[Unit]
Description=Govee LAN control server (UDP 4003/4002)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=govee
WorkingDirectory=/opt/govee
ExecStart=/usr/bin/python3 /opt/govee/govee_server.py
Environment=GOVEE_CONFIG=/opt/govee/config.json
# Optional: set a key, then send X-Api-Key: <key> on POST/DELETE requests
#Environment=GOVEE_API_KEY=change-me
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
